{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/server", "run", "dev"],
      "port": 4000
    },
    {
      "name": "app-web",
      "runtimeExecutable": "npx",

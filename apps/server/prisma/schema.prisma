generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Allowed values for status/role/kind strings live in /shared and are enforced by the API.

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  // Not @unique: MongoDB unique indexes reject multiple guests without an email. Uniqueness is enforced in /auth.
  email         String?
  role          String         @default("USER") // USER | REVIEWER
  isGuest       Boolean        @default(true)
  // Firebase Authentication user id, set when signing in with Google.
  firebaseUid   String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  campaigns     Campaign[]
  contributions Contribution[]
  notifications Notification[]
  follows       Follow[]
  saves         Save[]
  pushTokens    PushToken[]
  prefs         Json?

  @@index([email])
  @@index([firebaseUid])
}

model Campaign {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  slug           String           @unique
  ownerId        String           @db.ObjectId
  owner          User             @relation(fields: [ownerId], references: [id])
  status         String           @default("DRAFT")
  // Denormalised from content for listing/search.
  title          String           @default("")
  summary        String           @default("")
  category       String           @default("")
  creatorName    String           @default("")
  creatorType    String           @default("Individual")
  coverImage     String           @default("")
  content        Json // DraftContent
  // Content waiting for re-review after a material edit to a live campaign.
  pendingContent Json?
  goal           Float?
  raised         Float            @default(0)
  backerCount    Int              @default(0)
  featured       Boolean          @default(false)
  isDemo         Boolean          @default(false)
  // Distribution readiness checklist, set by reviewers.
  budgetApproved Boolean          @default(false)
  adSetupReady   Boolean          @default(false)
  submittedAt    DateTime?
  publishedAt    DateTime?
  endsAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  contributions  Contribution[]
  decisions      ReviewDecision[]
  updates        CampaignUpdate[]
  follows        Follow[]
  saves          Save[]
  feedback       Feedback[]
  complaints     Complaint[]
  report         Report?

  @@index([status])
  @@index([category])
}

model Contribution {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId        String   @db.ObjectId
  campaign          Campaign @relation(fields: [campaignId], references: [id])
  userId            String?  @db.ObjectId
  user              User?    @relation(fields: [userId], references: [id])
  amount            Float
  platformFee       Float
  processingFee     Float
  total             Float
  estimatedReach    Int
  status            String   @default("PENDING") // PENDING | SUCCEEDED | FAILED | CANCELLED | REFUNDED
  failureReason     String?
  showName          Boolean  @default(false)
  displayName       String?
  receiptEmail      String?
  receiptNo         String   @unique
  // SIMULATED or RAZORPAY_TEST. Live payment keys are refused by the server.
  provider          String   @default("SIMULATED")
  providerOrderId   String?
  providerPaymentId String?
  cardLast4         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([campaignId, status])
}

model ReviewDecision {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  actorId    String?  @db.ObjectId
  actorName  String?
  action     String
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())
}

model CampaignUpdate {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  title      String
  body       String
  createdAt  DateTime @default(now())
}

model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  kind       String
  title      String
  body       String
  campaignId String?  @db.ObjectId
  read       Boolean  @default(false)
  // Always set (random when not deduplicating): MongoDB unique indexes treat null as a value.
  dedupeKey  String
  createdAt  DateTime @default(now())

  @@unique([userId, dedupeKey])
}

model Follow {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  campaignId String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, campaignId])
}

model Save {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  campaignId String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, campaignId])
}

model Feedback {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String   @db.ObjectId
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  userId     String?  @db.ObjectId
  question   String // VISUALS | MIND_CHANGED
  answer     String // NO | SOMEWHAT | YES
  createdAt  DateTime @default(now())
}

model Report {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  campaignId    String    @unique @db.ObjectId
  campaign      Campaign  @relation(fields: [campaignId], references: [id])
  adSpend       Float     @default(0)
  impressions   Int?
  measuredReach Int?
  clicks        Int?
  byChannel     Json?
  startedAt     DateTime?
  endedAt       DateTime?
  final         Boolean   @default(false)
  updatedAt     DateTime  @updatedAt
}

/// Audience reports about a campaign, handled by reviewers.
model Complaint {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  campaignId String    @db.ObjectId
  campaign   Campaign  @relation(fields: [campaignId], references: [id])
  userId     String?   @db.ObjectId
  reason     String
  details    String?
  status     String    @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolution String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([campaignId])
}

/// Expo push tokens: one per installed app. A token moves to whoever signs in on that device.
model PushToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

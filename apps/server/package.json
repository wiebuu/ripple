{
  "name": "campaign-amplify-server",
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "db:push": "prisma db push --skip-generate",
    "setup": "prisma generate && prisma db push --skip-generate && tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "db:local": "mkdir -p .mongo-data && mongod --replSet rs0 --dbpath .mongo-data --port 27018 --bind_ip 127.0.0.1 --quiet",
    "db:init": "mongosh --quiet --port 27018 --eval \"try { rs.status().ok } catch (e) { rs.initiate({ _id: \\\"rs0\\\", members: [{ _id: 0, host: \\\"127.0.0.1:27018\\\" }] }).ok }\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}

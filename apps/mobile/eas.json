{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://YOUR_VPS_IP:4000",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": ""
      }
    },
    "production": {}
  }
}
